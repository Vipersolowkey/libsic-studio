# Copy this file to .env and fill in your own values. Never commit .env.
# Replace <username>, <password> and <cluster-address> with the values from MongoDB Atlas.
# "libsic" after the slash is the database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/libsic?retryWrites=true&w=majority
PORT=4000

# Only if you get "querySrv ECONNREFUSED" when starting the server, remove the # on the next line:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Accounts: the secret that signs login tokens. REQUIRED on the live server (the API refuses to start without it), at least 32 characters.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# On your laptop you can leave it out (a random one is used, so you are signed out when the server restarts).
# JWT_SECRET=

# --- Settings for the live server (all optional; set them on the host, for example in Render's Environment tab) ---
# Error monitoring: create a free project at https://sentry.io (platform Node.js) and paste its DSN here.
# SENTRY_DSN=
# Visit counter: choose any long random text. The totals are shown at <your API address>/stats (the page asks for it).
# STATS_TOKEN=
# Limits per visitor. The defaults are fine; raise them only if many people share one internet connection at an event.
# REQUESTS_PER_MINUTE=300
# REGISTERS_PER_15_MIN=30
# LOGIN_FAILURES_PER_15_MIN=10
# WRITES_PER_MINUTE=40
# CREATES_PER_10_MIN=60
# The most rooms and custom CDs the database may hold (a safety net for the free Atlas size).
# MAX_ROOMS=50000
# MAX_CDS=50000
