# Copy this file to .env and fill in your own values. Never commit .env.
# Replace <username>, <password> and <cluster-address> with the values from MongoDB Atlas.
# "libsic" after the slash is the database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/libsic?retryWrites=true&w=majority
PORT=4000

# Only if you get "querySrv ECONNREFUSED" when starting the server, remove the # on the next line:
# DNS_SERVERS=8.8.8.8,1.1.1.1
