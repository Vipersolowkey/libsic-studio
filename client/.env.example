# Address of the API. Copy this file to .env to change it.
# Leave it out while developing: the default is the API on your own computer.
VITE_API_URL=http://localhost:4000
# Live site: VITE_API_URL=https://libsic-studio-api.onrender.com

# Error monitoring (optional). The DSN of a free Sentry project of platform "Browser JavaScript". Set it where the site is built.
# VITE_SENTRY_DSN=
